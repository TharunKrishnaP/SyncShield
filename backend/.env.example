# FDR backend configuration — copy to .env and fill in credentials you hold.
# All keys are OPTIONAL; every connector degrades gracefully without them.

# ---- Dashboard cadence ----
# How often the whole pipeline re-pulls live data and pushes to the dashboard (seconds).
# Do not lower below 60: Open-Meteo free tier allows ~10k calls/day.
LIVE_REFRESH_SECONDS=60

# ---- History lake ----
# Append-only time series of water levels / rainfall / AI risk scores (SQLite).
# HISTORY_DB_PATH=/absolute/path/to/history.db
HISTORY_RETENTION_HOURS=168

# ---- Official data API keys (accreditation required) ----
# India Meteorological Department (https://api.imd.gov.in) — district forecasts & rain
#IMD_API_KEY=
# CWC National Water Data Portal (https://nwdp.nwic.gov.in) — river telemetry
#NWDP_API_KEY=
# NDMA SACHET (https://sachet.ndma.gov.in) — CAP disaster alerts
#SACHET_API_KEY=
# ISRO Bhoonidhi (https://bhoonidhi.nrsc.gov.in) — Sentinel-1 SAR archive
#BHOONIDHI_API_KEY=
# NDEM (https://ndem.nrsc.gov.in) — national disaster emergency management portal
#NDEM_API_KEY=

# ---- Simulation ----
#SIMULATION_ENABLED=true
#SIMULATION_SPEED_MULTIPLIER=10.0