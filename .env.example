# Copy this file to .env and fill in your credentials.
#   cp .env.example .env      (PowerShell:  Copy-Item .env.example .env)
# .env is git-ignored - never commit real credentials.
#
# Verify with:  python ml/sar/build_india_2025_2026.py preflight

# ---- Copernicus Data Space Ecosystem -------------------------------------
# Free account: https://dataspace.copernicus.eu/
# Register, then click the verification link in the incoming email, THEN set
# these. An unverified account is rejected by the token endpoint with a 401.
#
# Individual-account quotas (verified against CDSE Quotas docs, Oct 2026):
#   12 TB/month transfer, 2000 req/min, 20 MB/s per connection,
#   4 concurrent connections, token valid 10 min (refreshable to 60 min).
CDSE_USER=your.email@example.com
CDSE_PASS=

# ---- Optional overrides --------------------------------------------------
# Where bulk SAR/DEM data is written. Keep this on a large non-system volume;
# a full scene zip is ~1.7 GB and an unzipped+calibrated SAFE is ~4.5 GB.
ML_SAR_DIR=F:/floodml/sar

# Which SAR artifact the live backend serves. Swap this to roll out a newly
# trained model without a code change or a backend restart (hot-reloads on
# artifact mtime). Point it at sar_unet_2025_2026 once the 2025-26 retrain
# has beaten the Sen1Floods11 baseline (val_iou 0.2758).
# ML_SAR_DIR=ml/artifacts/sar_unet_2025_2026
